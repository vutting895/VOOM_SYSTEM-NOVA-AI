{
  "$schema": "https://raw.githubusercontent.com/cloudflare/workers-sdk/main/packages/wrangler/config-schema.json",
  "name": "voom-mt5-bridge-relay",
  "main": "worker.js",
  "compatibility_date": "2026-10-29",
  "workers_dev": true,
  "durable_objects": {
    "bindings": [
      {
        "name": "BRIDGE_SESSIONS",
        "class_name": "BridgeSession"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["BridgeSession"]
    }
  ],
  "observability": {
    "enabled": true
  }
}
