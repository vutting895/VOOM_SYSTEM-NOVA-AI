# Safe placeholder template only. Copy to a local/private environment file; never commit real values.
# NOVA local LLM (optional; Ollama/model must be installed separately)
NOVA_LLM_BASE_URL=http://127.0.0.1:11434
NOVA_LLM_MODEL=llama3.2:1b
NOVA_MARKET_SYMBOL=BTCUSDT
NOVA_MARKET_INTERVAL=1h

# Optional read-only exchange keys only; disable withdrawals and trading.
BINANCE_API_KEY=
BINANCE_API_SECRET=
BYBIT_API_KEY=
BYBIT_API_SECRET=

# MT5 read-only bridge placeholders; these do not enable order placement.
MT5_BRIDGE_HEALTH_URL=
MT5_BRIDGE_TOKEN=
NEXT_PUBLIC_MT5_READONLY_PROXY_URL=

# Supabase public/auth configuration. Never put service-role keys in NEXT_PUBLIC_*.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Optional server-side provider settings for retained legacy/source tools.
PORT=3000
NODE_ENV=development
GOOGLE_GENERATIVE_AI_API_KEY=
VOOM_BRIDGE_SHARED_SECRET=
CORS_ORIGINS=

# Safety defaults. Keep both legacy and NOVA flags disabled.
TRADING_MODE=paper
LIVE_TRADING_ENABLED=false
VOOM_LIVE_TRADING_ENABLED=false
