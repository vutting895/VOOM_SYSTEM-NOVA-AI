# Copy to .env locally; never commit real credentials.
# Local LLM (requires Ollama installed and model pulled separately)
NOVA_LLM_BASE_URL=http://127.0.0.1:11434
NOVA_LLM_MODEL=llama3.2:1b
# Public market data (no key required)
NOVA_MARKET_SYMBOL=BTCUSDT
NOVA_MARKET_INTERVAL=1h
# Optional exchange read-only keys only. Disable withdrawals and trading.
BINANCE_API_KEY=
BINANCE_API_SECRET=
BYBIT_API_KEY=
BYBIT_API_SECRET=
# MT5 bridge placeholders; not used to place orders by this project.
MT5_BRIDGE_HEALTH_URL=
MT5_BRIDGE_TOKEN=
# Safety stays off.
VOOM_LIVE_TRADING_ENABLED=false
