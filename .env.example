# Broker credentials and tenant-local bridge secrets are never stored in this file.
# Exness MT5 Demo access is provisioned only through the existing tenant-scoped Windows bridge.
VOOM_LIVE_TRADING_ENABLED=false
NOVA_LLM_BASE_URL=
NOVA_LLM_MODEL=
NOVA_MARKET_INTERVAL=
NOVA_MARKET_SYMBOL=

# Required by POST /api/chat to verify a Supabase user session before body parsing.
# Use the project URL and publishable key (or legacy anon key); never a service-role key.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Local Docker Compose defaults; replace password before exposing services.
POSTGRES_DB=nova
POSTGRES_USER=nova
POSTGRES_PASSWORD=replace-with-a-long-random-password
FRONTEND_BIND=127.0.0.1
NOVA_TELEGRAM_BOT_TOKEN=
NOVA_TELEGRAM_CHAT_ID=
