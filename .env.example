# Broker credentials and tenant-local bridge secrets are never stored in this file.
# Exness MT5 Demo access remains in the existing tenant-scoped Windows Bridge/Cloudflare Relay.
VOOM_LIVE_TRADING_ENABLED=false
NOVA_SYSTEM_HUB_URL=https://voom-system-hub.suwapat787.workers.dev
NOVA_LLM_BASE_URL=
NOVA_LLM_MODEL=
NOVA_MARKET_INTERVAL=
NOVA_MARKET_SYMBOL=

# Binance public market prices do not require API keys. Private account access and order APIs are not enabled.
# No Binance secret is used by the read-only public price function.

# Local Docker Compose defaults; replace password before exposing services.
POSTGRES_DB=nova
POSTGRES_USER=nova
POSTGRES_PASSWORD=replace-with-a-long-random-password
FRONTEND_BIND=127.0.0.1
NOVA_TELEGRAM_BOT_TOKEN=
NOVA_TELEGRAM_CHAT_ID=
