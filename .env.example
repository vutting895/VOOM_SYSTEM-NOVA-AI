# Safe defaults. Never put credentials, tokens, passwords, or tenant route maps here.
LIVE_TRADING_ENABLED=false
BROKER_WRITES_ENABLED=false
NOVA_APPROVALS_ENABLED=false
NEXT_PUBLIC_NOVA_APPROVALS_ENABLED=false

# Legacy compatibility flag; remains disabled.
VOOM_LIVE_TRADING_ENABLED=false

# Non-secret runtime configuration
NOVA_LLM_BASE_URL=
NOVA_LLM_MODEL=
NOVA_MARKET_INTERVAL=
NOVA_MARKET_SYMBOL=
FRONTEND_BIND=127.0.0.1

# Local-only placeholders; replace privately before starting local services.
POSTGRES_DB=nova
POSTGRES_USER=nova
POSTGRES_PASSWORD=

# Notification credentials are provisioned outside this file.
NOVA_TELEGRAM_BOT_TOKEN=
NOVA_TELEGRAM_CHAT_ID=
