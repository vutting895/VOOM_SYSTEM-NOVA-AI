# Safe defaults. Never put credentials, tokens, passwords, or tenant route maps here.
LIVE_TRADING_ENABLED=false
BROKER_WRITES_ENABLED=false
NOVA_APPROVALS_ENABLED=false
NEXT_PUBLIC_NOVA_APPROVALS_ENABLED=false

# Legacy compatibility flag; remains disabled.
VOOM_LIVE_TRADING_ENABLED=false

# Frontend Supabase configuration (publishable/anon key only; never service_role).
VITE_SUPABASE_URL=https://tlyyxufuiimrbaksoitf.supabase.co
VITE_SUPABASE_ANON_KEY=
# Legacy Netlify variable names are supported; keep both values on the NOVA project.
NEXT_PUBLIC_SUPABASE_URL=https://tlyyxufuiimrbaksoitf.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-side Supabase Auth verification (publishable/anon key only; never service_role).
SUPABASE_URL=https://tlyyxufuiimrbaksoitf.supabase.co
SUPABASE_PUBLISHABLE_KEY=

# Non-secret runtime configuration
NOVA_LLM_BASE_URL=
NOVA_LLM_MODEL=
NOVA_MARKET_INTERVAL=
NOVA_MARKET_SYMBOL=
FRONTEND_BIND=127.0.0.1

# Local-only placeholders; replace privately before starting local services.
POSTGRES_DB=nova
POSTGRES_USER=nova
POSTGRES_PASSWORD=

# Notification credentials are provisioned outside this file.
NOVA_TELEGRAM_BOT_TOKEN=
NOVA_TELEGRAM_CHAT_ID=
