# Repository-root local research defaults only.
# Copy to .env for the local Python research utilities that read NOVA_LLM_*.
# Never put provider API keys, Supabase service-role credentials, broker passwords,
# tenant tokens, or customer credentials in this shared template.

# Local Ollama-compatible inference adapter (workers/gen-ai)
NOVA_LLM_BASE_URL=http://127.0.0.1:11434
NOVA_LLM_MODEL=llama3.2:1b

# Non-secret public market-data defaults
NOVA_MARKET_SYMBOL=BTCUSDT
NOVA_MARKET_INTERVAL=1h

# Safety invariant — keep disabled.
VOOM_LIVE_TRADING_ENABLED=false
