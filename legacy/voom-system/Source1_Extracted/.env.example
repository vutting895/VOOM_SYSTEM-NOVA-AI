# Mean Rejection SMC Wave v6.2 BEST โ€” ENV
# Copy to .env and fill secrets
BEST_CONFIG_APPLIED=true
CONFLUENCE_MIN=4
DL_WEIGHT=0.25
DIST_ATR_MULT=1.8
Z_SCORE_THRESH=2.2
RISK_PCT=0.01
RR_TP1=1.5
RR_TP2=3.1
RR_TP1_CLOSE_PCT=0.5
VOLATILITY_ATR_MIN=0.4
VOLATILITY_ATR_MAX=3.5
SESSION_FILTER=London,NY
MEAN_PERIOD=50
SMC_OB_LOOKBACK=20
FVG_MIN_SIZE_ATR=0.3

# Fleet
AI_FLEET_IDS=AI-1,AI-2,AI-3,AI-4
API_PORT=8000
API_HOST=127.0.0.1

# Exchange (set your keys)
EXCHANGE=binance
EXCHANGE_API_KEY=your_api_key_here
EXCHANGE_SECRET=your_secret_here
SYMBOLS=XAUUSD,BTCUSD,ETHUSD
TIMEFRAME=5m
PAPER_TRADING=true

# Models
MODEL_DIR=./models
BEST_MODEL_DIR=./models/best
INFERENCE_MAX_MS=50

# Retrain
RETRAIN_CRON=Sunday 02:00 UTC
RETRAIN_SILENT=true
TUNE_TRIALS=80

# Logging
LOG_LEVEL=WARNING

