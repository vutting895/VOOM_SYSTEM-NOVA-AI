# Host-side tools use localhost. Compose overrides these with redis://redis.
REDIS_BROKER_URL=redis://localhost:6379/0
REDIS_STATE_URL=redis://localhost:6379/1
REDIS_RESULT_BACKEND_URL=redis://localhost:6379/2
NOVA_CELERY_CONCURRENCY=2

# Generate a unique 48+ character secret; configure the same value as the
# Cloudflare System Hub NOVA_ANALYSIS_DISPATCH_TOKEN Worker secret.
NOVA_ANALYSIS_INTERNAL_TOKEN=replace-with-a-unique-random-secret-at-least-48-characters
