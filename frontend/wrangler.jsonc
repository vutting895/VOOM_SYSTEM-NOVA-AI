{
  // Legacy/rollback frontend configuration only; production hosting is Netlify.
  // Cloudflare Workers in the production workflow host backend APIs only.
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "voom-system-nova-ui",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-27",
  "compatibility_flags": ["nodejs_compat"],
  "upload_source_maps": true,
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  }
}
