{
  // Canonical customer-facing frontend runtime; deploy this Worker, not Vercel.
  // Keep this name aligned with the Cloudflare Worker: voom-system-nova-ui.
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "voom-system-nova-ui",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-27",
  "compatibility_flags": ["nodejs_compat"],
  "upload_source_maps": true,
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  }
}
