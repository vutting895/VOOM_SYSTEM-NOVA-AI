# Local Next.js frontend settings.
# NEXT_PUBLIC_* values are bundled for browser access. Use only the Supabase
# publishable/anon key here; NEVER use a service_role or secret key.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_publishable_or_anon_key
NEXT_PUBLIC_SYSTEM_HUB_URL=https://voom-system-hub.suwapat787.workers.dev
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your_turnstile_site_key
